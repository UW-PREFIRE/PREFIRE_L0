"Orbit_L0_Data":{
    "UTC_datetime_repr": {
             "long_name": "UTC datetime representation",
             "description": "UTC datetime of bus telemetry entry, represented as an integer",
             "value_meaning": "YYYYMMDDhhmmssxxx, UTC date and time of bus telemetry entry, xxx=milliseconds)",
             "C_dimensions": ["atrack"],
             "np_dtype": "int64", "fill_value": -9999,
             "compression": [4, true],
             "calendar": "standard" },
    "ctime": {
             "units": "seconds since 2000-01-01T00:00:00Z",
             "long_name": "continuous_time",
             "description": "at each bus telemetry entry; similar to TAI, and referenced to the epoch 2000-01-01T00:00:00 UTC",
             "C_dimensions": ["atrack"],
             "np_dtype": "float64", "fill_value": -9.999e3,
             "compression": [4, true],
             "calendar": "standard" },
    "SC_in_Earth_umbra": {
             "long_name": "spacecraft is in Earth umbra",
             "description": "is the spacecraft currently in the Earth umbra?",
             "flag_values": [0, 1],
             "flag_meanings": "no, yes",
             "C_dimensions": ["atrack"],
             "np_dtype": "int8", "fill_value": -99,
             "compression": [4, true] },
    "position_wrt_ECI_1": {
             "units": "km",
             "long_name": "position component 1 with respect to ECI frame",
             "description": "orbit position component 1 (x), reported in the ECI (J2000) frame",
             "C_dimensions": ["atrack"],
             "np_dtype": "float64", "fill_value": -9.999999e6,
             "compression": [4, true] },
    "position_wrt_ECI_2": {
             "units": "km",
             "long_name": "position component 2 with respect to ECI frame",
             "description": "orbit position component 2 (y), reported in the ECI (J2000) frame",
             "C_dimensions": ["atrack"],
             "np_dtype": "float64", "fill_value": -9.999999e6,
             "compression": [4, true] },
    "position_wrt_ECI_3": {
             "units": "km",
             "long_name": "position component 3 with respect to ECI frame",
             "description": "orbit position component 3 (z), reported in the ECI (J2000) frame",
             "C_dimensions": ["atrack"],
             "np_dtype": "float64", "fill_value": -9.999999e6,
             "compression": [4, true] },
    "velocity_wrt_ECI_1": {
             "units": "km s-1",
             "long_name": "velocity component 1 with respect to ECI frame",
             "description": "orbit velocity component 1 (u), reported in the ECI (J2000) frame",
             "C_dimensions": ["atrack"],
             "np_dtype": "float64", "fill_value": -9.999e3,
             "compression": [4, true] },
    "velocity_wrt_ECI_2": {
             "units": "km s-1",
             "long_name": "velocity component 2 with respect to ECI frame",
             "description": "orbit velocity component 2 (v), reported in the ECI (J2000) frame",
             "C_dimensions": ["atrack"],
             "np_dtype": "float64", "fill_value": -9.999e3,
             "compression": [4, true] },
    "velocity_wrt_ECI_3": {
             "units": "km s-1",
             "long_name": "velocity component 3 with respect to ECI frame",
             "description": "orbit velocity component 3 (w), reported in the ECI (J2000) frame",
             "C_dimensions": ["atrack"],
             "np_dtype": "float64", "fill_value": -9.999e3,
             "compression": [4, true] },
    "ref_altitude": {
             "units": "km",
             "long_name": "altitude (reference only)",
             "description": "approximate spacecraft altitude with respect to the WGS84 ellipsoid (reference only)",
             "C_dimensions": ["atrack"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "ref_latitude": {
             "units": "degrees_north",
             "long_name": "latitude (reference only)",
             "description": "approximate geodetic latitude (reference only)",
             "C_dimensions": ["atrack"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "ref_longitude": {
             "units": "degrees_east",
             "long_name": "longitude (reference only)",
             "description": "approximate geodetic longitude (reference only)",
             "C_dimensions": ["atrack"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "granule_edge_ctime": {
             "units": "seconds since 2000-01-01T00:00:00Z",
             "long_name": "granule edge continuous_time",
             "description": "similar to TAI, referenced to the epoch 2000-01-01T00:00:00 UTC, and valid at a granule edge",
             "C_dimensions": ["gr_edge"],
             "np_dtype": "float64", "fill_value": -9.999e3,
             "compression": [4, true],
             "calendar": "standard" },
    "granule_ID": {
             "long_name": "granule ID",
             "description": "for each granule (defined as starting at each granule edge ctime), an identification number",
             "C_dimensions": ["gr_edge"],
             "np_dtype": "int32", "fill_value": -9999,
             "compression": [4, true] }
}
}
