"TIRS_L0_Data": {
    "ctime": {
             "units": "seconds since 2000-01-01T00:00:00Z",
             "long_name": "continuous_time at the science packet look end",
             "description": "similar to TAI, referenced to the epoch 2000-01-01T00:00:00 UTC, and valid at the end of the look (i.e., end of TIRS image integration)",
             "C_dimensions": ["atrack_scipkt"],
             "F_dimensions": ["atrack_scipkt"],
             "np_dtype": "float64", "fill_value": -9.999e3,
             "compression": [4, true],
             "calendar": "standard" },
    "CDH_T": {
             "units": "K",
             "long_name": "C+DH thermistor temperature",
             "description": "temperatures from C+DH thermistors",
             "C_dimensions": ["atrack_scipkt", "n_CDH_therm"],
             "F_dimensions": ["n_CDH_therm", "atrack_scipkt"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "ROIC_T": {
             "units": "K",
             "long_name": "ROIC thermistor temperature",
             "description": "temperatures from ROIC thermistors",
             "C_dimensions": ["atrack_scipkt", "n_ROIC_therm"],
             "F_dimensions": ["n_ROIC_therm", "atrack_scipkt"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "TIRS_T": {
             "units": "K",
             "long_name": "TIRS thermistor temperature",
             "description": "temperatures from TIRS thermistors",
             "C_dimensions": ["atrack_scipkt", "n_TIRS_therm"],
             "F_dimensions": ["n_TIRS_therm", "atrack_scipkt"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "MoE_T": {
             "units": "K",
             "long_name": "MoE thermistor temperature",
             "description": "temperatures from motor electronics thermistors",
             "C_dimensions": ["atrack_scipkt"],
             "F_dimensions": ["atrack_scipkt"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "PDU_12V_I": {
             "units": "A",
             "long_name": "PDU 12V rail electrical current",
             "description": "electrical current on the power distribution unit 12-volt rail",
             "C_dimensions": ["atrack_scipkt"],
             "F_dimensions": ["atrack_scipkt"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "PDU_SCBATT_I": {
             "units": "A",
             "long_name": "PDU SC battery rail electrical current",
             "description": "electrical current on the power distribution unit spacecraft battery rail",
             "C_dimensions": ["atrack_scipkt"],
             "F_dimensions": ["atrack_scipkt"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "MoE_12V_I": {
             "units": "A",
             "long_name": "MoE 12V rail electrical current",
             "description": "electrical current on the motor electronics 12-volt rail",
             "C_dimensions": ["atrack_scipkt"],
             "F_dimensions": ["atrack_scipkt"],
             "np_dtype": "float32", "fill_value": -9.999e3,
             "compression": [4, true] },
    "encoder_pos": {
             "units": "count",
             "long_name": "encoder position",
             "description": "raw DN (digital number) indicating the TIRS movable mirror position from the mirror motor encoder at the end of the science packet look",
             "C_dimensions": ["atrack_scipkt"],
             "F_dimensions": ["atrack_scipkt"],
             "np_dtype": "uint16",
             "compression": [4, true] },
    "engdata_tlm": {
             "long_name": "raw engineering data for science packet",
             "description": "block of various TIRS engineering telemeters",
             "C_dimensions": ["atrack_scipkt", "n_engd"],
             "F_dimensions": ["n_engd", "atrack_scipkt"],
             "np_dtype": "uint16",
             "compression": [4, true] },
    "misc_tlm": {
             "long_name": "other raw telemeters for science packet",
             "description": "includes ACK and NACK counts, et cetera",
             "C_dimensions": ["atrack_scipkt", "n_misc"],
             "F_dimensions": ["n_misc", "atrack_scipkt"],
             "np_dtype": "uint16",
             "compression": [4, true] },
    "adj_srd_DN": {
             "units": "count",
             "long_name": "adjusted spectroradiometer digital number",
             "description": "spectroradiometer DN (adjusted for mapping/polarity/offset) of the science packet",
             "C_dimensions": ["allspectral", "xtrack", "atrack_scipkt"],
             "F_dimensions": ["atrack_scipkt", "xtrack", "allspectral"],
             "np_dtype": "int32",
             "compression": [4, true] },
    "otherpkt_APID": {
             "long_name": "other packet APID",
             "description": "for a non-science packet or an invalid packet",
             "C_dimensions": ["atrack_other"],
             "F_dimensions": ["atrack_other"],
             "np_dtype": "uint16",
             "compression": [4, true],
             "optional": "yes" },
    "otherpkt_byte_startpos": {
             "units": "byte",
             "long_name": "other packet starting byte position",
             "description": "starting byte position of non-science packet or invalid packet, bytes from the beginning of the raw L0-payload input file",
             "C_dimensions": ["atrack_other"],
             "F_dimensions": ["atrack_other"],
             "np_dtype": "int32", "fill_value": -9999,
             "compression": [4, true],
             "optional": "yes" },
    "otherpkt_nom_bytesize": {
             "units": "byte",
             "long_name": "other packet nominal byte-size",
             "description": "nominal length of a non-science packet or an invalid packet",
             "C_dimensions": ["atrack_other"],
             "F_dimensions": ["atrack_other"],
             "np_dtype": "uint16",
             "compression": [4, true],
             "optional": "yes" },
    "otherpkt_info_flag": {
             "long_name": "other packet informational flag",
             "description": "informational flag about the packet",
             "flag_values": [0, 1, 2, 3, 4, 5],
             "flag_meanings": "[0] non-science (non-CCSDS), [1] non-science CCSDS packet, [2] science packet that failed top-level CRC check, [3] science packet that failed ENG and ROIC CRC checks, [4] science packet that failed ENG CRC check, [5] science packet that failed ROIC CRC check",
             "C_dimensions": ["atrack_other"],
             "F_dimensions": ["atrack_other"],
             "np_dtype": "int8",
             "compression": [4, true],
             "optional": "yes" }
}
}
